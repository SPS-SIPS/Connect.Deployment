# Database password (used by Postgres, Keycloak, and SIPS Connect)
DB_PASSWORD=ChangeThisPassword123!

# Host machine IP address (used for service URLs, Keycloak, etc.)
HOST_MACHINE_IP=<HOST_MACHINE_IP>

# SSL / Keystore Passwords
KEYCLOAK_KEYSTORE_PASSWORD=ChangeThisPassword123!
SIPS_CONNECT_TLS_PFX_PASSWORD=ChangeThisPassword123!

# Application Ports:
SIPS_CONNECT_PORT=9036
SIPS_CONNECT_HTTPS_PORT=9030
IDP_PORT=9031
LOKI_PORT=3500
GRAFANA_PORT=9033
PORTAL_PORT=9034
CB_PORT=9032
DB_PORT=5432
PROMETHEUS_PORT=9090

# Institution Details
INSTITUTION_NAME=<INSTITUTION_NAME>
DB_HOST=sips-connect-db

# Serilog Configuration
Serilog__WriteTo__File__Args__path=/logs/log.log
Serilog__MinimumLevel__Override__Microsoft=Information
Serilog__MinimumLevel__Override__System=Information
Serilog__MinimumLevel__Default=Information

ASPNETCORE_ENVIRONMENT=Development
Xades__DefaultSignatureMethod=SHA256withRSA
Xades__WithoutPKI=false
Xades__BaseDN="<SPS_ISSUING_CA_BASE_DN>"

PGUSER=postgres
POSTGRES_PASSWORD=${DB_PASSWORD}
POSTGRES_DB=postgres

ConnectionStrings__db="Host=${DB_HOST};Database=sips.db_${INSTITUTION_NAME};Include Error Detail=True;Username=postgres;Password=${DB_PASSWORD};"

# SIPS Connect UI CORS Origin (Must be HTTPS and match PORTAL_PORT)
CorsPolicies__Origins__0="https://${HOST_MACHINE_IP}:${PORTAL_PORT}"

# Keycloak Configuration
KC_DB=postgres
KC_DB_USERNAME=postgres
KC_DB_PASSWORD=${DB_PASSWORD}
KC_DB_URL="jdbc:postgresql://${DB_HOST}/postgres"
KEYCLOAK_HOST_IP=${HOST_MACHINE_IP}
KEYCLOAK_KEYSTORE_PASSWORD=${KEYCLOAK_KEYSTORE_PASSWORD}

Keycloak__Realm__Host="idp:${IDP_PORT}"
Keycloak__Realm__Protocol="https"
Keycloak__Realm__ValidateIssuer=true
Keycloak__Realm__Name="mgt"
Keycloak__Realm__Audience="sc-api"
Keycloak__Realm__ValidIssuers__0="https://${HOST_MACHINE_IP}:${IDP_PORT}/realms/mgt"

# DB File Persistence
DbPersistenceFile="/app/db.json"

# Kestrel HTTPS Certificate Configuration
Kestrel__Endpoints__Https__Certificate__Path=/certs/sips-connect.pfx
Kestrel__Endpoints__Https__Certificate__Password=${SIPS_CONNECT_TLS_PFX_PASSWORD}
Kestrel__Endpoints__Http__Url=http://0.0.0.0:8080
Kestrel__Endpoints__Https__Url=https://0.0.0.0:443

# Core Bank API Keys (Must match appsettings.json ApiKeys)
SIPS__ApiKey=your_test_core_bank_api_key
SIPS__ApiSecret=your_test_core_bank_api_secret
ISO20022__Key=your_test_core_bank_api_key
ISO20022__Secret=your_test_core_bank_api_secret

# Core Bank Defaults:
ISO20022_VERIFICATION_URL=http://sips-corebank:8080/api/CB/Verify
ISO20022_TRANSFER_URL=http://sips-corebank:8080/api/CB/Transfer
ISO20022_RETURN_URL=http://sips-corebank:8080/api/CB/Return
ISO20022_STATUS_URL=http://sips-corebank:8080/api/CB/Status
ISO20022_COMPLETION_NOTIFICATION_URL=http://sips-corebank:8080/api/CB/CompletionNotification

# P2G callback OAuth client-credentials auth (Optional):
# CALLBACK_AUTH_ENABLED=true
# CALLBACK_TOKEN_ENDPOINT=https://<keycloak-host>/realms/<realm>/protocol/openid-connect/token
# CALLBACK_CLIENT_ID=sips-connect-p2g
# CALLBACK_CLIENT_SECRET=<secret>
# CALLBACK_SCOPE=
# CALLBACK_AUDIENCE=sps-p2g-gateway

# ==============================================================================
# PAPSS-Facing Integration Configuration
# Set PapssFacing__Enabled=true to enable PAPSS, or false for domestic-only rail.
# ==============================================================================
PapssFacing__Enabled=false
PapssFacing__CrossCurrencyEnabled=true
PapssFacing__IsoIngressUrl=https://<PAPSS_INGRESS_HOST>:8443/sips/messages
PapssFacing__AllowedHosts__0=<PAPSS_INGRESS_HOST>
PapssFacing__Environment=UAT
PapssFacing__RemoteWpSipsIdentity=<PAPSS_WP_SIPS_IDENTITY>
PapssFacing__SecurityProfile=<WP_SIPS_SECURITY_PROFILE>
PapssFacing__RequestTimeoutSeconds=30
PapssFacing__ReadinessStaleSeconds=300
PapssFacing__LocalCountry=<COUNTRY_CODE_ISO2>
PapssFacing__SendingCurrencies__0=<CURRENCY_CODE_1>
PapssFacing__SendingCurrencies__1=<CURRENCY_CODE_2>
PapssFacing__SpsPolicy__AllowedLocalInstruments__0=<ALLOWED_LOCAL_INSTRUMENT>

# Dynamic Core Bank Callback URL (uses HOST_MACHINE_IP and CB_PORT)
PapssFacing__CallbackMappingProfile=papss-callback-v1
PapssFacing__CallbackUrl=https://${HOST_MACHINE_IP}:${CB_PORT}/api/CB/CompletionNotification

# PAPSS Responder Trust Binding (Provided in the bilateral Onboarding Pack)
PapssFacing__ResponderTrust__CertificateSha256=<64_HEX_SHA256_FINGERPRINT>
PapssFacing__ResponderTrust__Authority=<AUTHORITY_NAME>
PapssFacing__ResponderTrust__TrustProfileVersion=<TRUST_PROFILE_VERSION>
PapssFacing__ResponderTrust__RequiredExtendedKeyUsageOid=<REQUIRED_EKU_OID>
