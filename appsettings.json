        ],
        "SpsPolicy": {
            "AllowedLocalInstruments": []
        },
        "ReadinessStaleSeconds": 300,
        "LocalCountry": "<ISO-3166-ALPHA-2>",
        "SendingCurrencies": ["<ISO-4217>"],
