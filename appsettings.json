{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo:Console": {
      "Name": "Console",
      "Args": {
        "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
        "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
      }
    },
    "WriteTo:File": {
      "Name": "File",
      "Args": {
        "path": "logs/log.log",
        "rollingInterval": "Day",
        "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ],
    "Destructure": [],
    "Properties": {
      "Application": "SPS System Logs"
    }
  },
  "ConnectionStrings": {
    "db": "Host=sips-connect-db;Database=sips.db_<INSTITUTION_NAME>;Include Error Detail=True;Username=postgres;Password={{DB_PASSWORD}};"
  },
  "AllowedHosts": "*",
  "Core": {
    "BaseUrl": "http://10.128.200.244:5004/api",
    "PublicKeysRepUrl": "/v1/Certificates/Download",
    "LoginEndpoint": "/v1/auth/login",
    "Username": "<BANK_SIPS_USERNAME>",
    "Password": "<BANK_SIPS_PASSWORD>",
    "BIC": "<BANK_BIC>",
    "SAFExpression": "*/10 * * * *",
    "SAFPage": 40,
    "SAFTimeZoneInfo": "Utc",
    "SAFMaxRetries": 10,
    "IncludeIdempotencyHeaders": true,
    "HttpTimeoutSeconds": 20,
    "CoreBankTimeoutSeconds": 3,
    "DbPersistTimeoutSeconds": 10,
    "IncludeCoreBankOnListing": false,
    "TransactionTimeoutMinutes": 10,
    "TimeoutWorkerSchedule": "*/15 * * * *",
    "CallbackSlaSeconds": 10,
    "CallbackInternalBudgetSeconds": 9,
    "VerificationOnlyMode": false,
    "CallbackAuthEnabled": false,
    "CallbackTokenEndpoint": "",
    "CallbackClientId": "",
    "CallbackClientSecret": "",
    "CallbackScope": "",
    "CallbackAudience": ""
  },
  "Xades": {
    "CertificatePath": "/certs/certificate.pem",
    "PrivateKeyPath": "/certs/private.pem",
    "PrivateKeyPassphrase": "",
    "ChainPath": "/certs/chain.pem",
    "Algorithms": [
      "SHA256withRSA"
    ],
    "VerificationWindowMinutes": 100,
    "BIC": "<BANK_BIC>",
    "WithoutPKI": false,
    "DefaultSignatureMethod": "SHA256withRSA",
    "BaseDN": "CN=sps issuing CA, DC=sps, DC=local"
  },
  "ISO20022": {
    "Verification": "http://sips-corebank:8080/api/CB/Verify",
    "CompletionNotification": "http://sips-corebank:8080/api/CB/CompletionNotification",
    "Transfer": "http://sips-corebank:8080/api/CB/Transfer",
    "Return": "http://sips-corebank:8080/api/CB/Return",
    "Status": "http://sips-corebank:8080/api/CB/Status",
    "SIPS": "http://<SIPS_SWITCH_HOST>:9001/v1/iso20022/incoming",
    "BIC": "<BANK_BIC>",
    "Agent": "<BANK_BIC>",
    "PayerBankCode": "<BANK_BIC>",
    "PayerChannel": "MOBILE",
    "Key": "your_corebank_api_key",
    "Secret": "your_corebank_api_secret"
  },
