    "PapssFacing": {
        "Enabled": false,
        "IsoIngressUrl": "https://<PAPSS-SERVICE-HOST>/sips/messages",
        "Environment": "UAT",
        "RemoteWpSipsIdentity": "<PAPSS-WP-SIPS-IDENTITY>",
        "SecurityProfile": "WP-SIPS-XADES-SHA256RSA",
        "RequestTimeoutSeconds": 30,
        "MaximumResponseBytes": 2000000,
        "AllowedHosts": [
